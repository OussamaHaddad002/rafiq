# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=development
LOG_LEVEL=INFO

# LLM provider: "openai", "anthropic", or "fake" (deterministic echo, no key needed)
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Empty = provider default (openai: gpt-5.4-mini, anthropic: claude-sonnet-5-5)
LLM_MODEL=
# OpenAI reasoning models only: none | minimal | low | medium | high. Lower is cheaper and faster.
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=1024

# Used when running the API outside Docker. docker compose overrides it to reach the db service.
DATABASE_URL=postgresql+asyncpg://rafiq:rafiq@localhost:5432/rafiq
