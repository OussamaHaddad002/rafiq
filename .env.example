# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=development
LOG_LEVEL=INFO

# LLM provider: "openai", "anthropic", or "fake" (deterministic echo, no key needed)
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Empty = provider default (openai: gpt-4o-mini, anthropic: claude-sonnet-5-5)
LLM_MODEL=
# Only for OpenAI reasoning models (o-series): none | minimal | low | medium | high. Ignored otherwise.
LLM_REASONING_EFFORT=
LLM_MAX_TOKENS=1024

# RAG. Empty provider = fake when LLM_PROVIDER=fake, otherwise OpenAI (uses OPENAI_API_KEY).
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=5
# One small LLM call per question so search covers fr/en/ar documents (recommended).
RAG_TRANSLATE_QUERIES=true

# Used when running the API outside Docker. docker compose overrides it to reach the db service.
DATABASE_URL=postgresql+asyncpg://rafiq:rafiq@localhost:5432/rafiq
